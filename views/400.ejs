<%- include('partials/header') %>
<section class="error-panel">
  <p class="error-code">Ошибка 400</p>
  <h1>Некорректные данные</h1>
  <ul class="error-list"><% errors.forEach(message => { %><li><%= message %></li><% }); %></ul>
  <div class="error-actions"><a class="button" href="<%= (typeof backUrl === 'string' ? backUrl : '/add') + webQuery %>">Вернуться к форме</a><a class="button button-secondary" href="/<%= webQuery %>">К списку комнат</a></div>
</section>
<%- include('partials/footer') %>
